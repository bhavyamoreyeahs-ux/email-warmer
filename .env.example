# ─────────────────────────────────────────────────────────────────────────────
# QuikReach environment configuration.
# Copy to `.env` for local development (git-ignored). NEVER commit real values.
# In production, inject these from the platform secret manager (see docs/security.md).
# Variables marked REQUIRED-PROD must be set when NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the web app (used for OAuth redirect URIs, links in emails,
# and same-origin checks on mutations). Must be https:// in production. REQUIRED-PROD
APP_URL=http://localhost:3020
# NextAuth reads this too — keep it identical to APP_URL.
NEXTAUTH_URL=http://localhost:3020

# PostgreSQL connection string. REQUIRED-PROD
# Local (npm run db:local):  postgres://quikreach:quikreach_local_dev_only@127.0.0.1:54329/quikreach
# Docker (docker compose up db): postgres://quikreach:quikreach_local_dev_only@127.0.0.1:5432/quikreach
DATABASE_URL=postgres://quikreach:quikreach_local_dev_only@127.0.0.1:54329/quikreach
# Max connections per process (web and worker each have a pool).
DATABASE_POOL_MAX=10
# Require TLS to the database (set true for managed Postgres).
DATABASE_SSL=false

# Session signing secret, ≥32 random bytes. `openssl rand -base64 48`. REQUIRED-PROD
NEXTAUTH_SECRET=

# ── Authentication mode ─────────────────────────────────────────────────────
# Set all three to authenticate through the QuikIT identity provider (OIDC).
# Leave empty for standalone email+password accounts (credentials mode).
# The QuikIT IdP contract must be confirmed by the integration owner.
QUIKIT_URL=
# Alternative name for QUIKIT_URL (OIDC issuer). Either may be set.
QUIKIT_ISSUER_URL=
QUIKIT_CLIENT_ID=
QUIKIT_CLIENT_SECRET=
# Allow self-serve signup in credentials mode. Defaults to true outside production,
# false in production. Email verification is NOT implemented (launch dependency).
ALLOW_SELF_SIGNUP=

# ── Secrets for data at rest ─────────────────────────────────────────────────
# AES-256-GCM keys for OAuth tokens / webhook secrets: "keyId:base64(32 bytes)",
# comma-separated, FIRST key encrypts, all keys decrypt (rotation).
# Generate: echo "k1:$(openssl rand -base64 32)". REQUIRED-PROD
TOKEN_ENCRYPTION_KEYS=
# HMAC key for hashing recipient addresses (distinct-recipient counting without
# storing addresses). `openssl rand -base64 32`. REQUIRED-PROD
RECIPIENT_HASH_KEY=

# ── Mailbox providers (OAuth apps you register — see docs/oauth-setup.md) ────
# Without these, the connect buttons are disabled; no connection is simulated.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "organizations" (work/school accounts only, default), "common", or a tenant id.
MICROSOFT_TENANT=organizations

# ── DNS checks ───────────────────────────────────────────────────────────────
# Comma-separated resolver IPs (e.g. 1.1.1.1,8.8.8.8). Empty = system resolver.
DNS_RESOLVERS=
# Per-query timeout (ms).
DNS_TIMEOUT_MS=4000

# ── AI diagnostics ───────────────────────────────────────────────────────────
# "anthropic" to use Claude; "none" to use the deterministic rules engine only.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000

# ── QuikReach's own notification email (optional) ────────────────────────────
# e.g. smtps://user:pass@smtp.example.com:465 — without it, email notifications
# are recorded as "not configured", never as sent.
SMTP_URL=
EMAIL_FROM=

# ── Retention (days) — PLACEHOLDER DEFAULTS pending product/security review ──
DEFAULT_EVENT_RETENTION_DAYS=90
DEFAULT_DIAGNOSTIC_RETENTION_DAYS=90
DEFAULT_AUDIT_RETENTION_DAYS=365

# ── Scheduling & worker ─────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
SCAN_INTERVAL_HOURS=24
SYNC_MAX_MESSAGES=500
INITIAL_SYNC_DAYS=14
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000
# Worker /healthz and /metrics port (0 disables).
WORKER_HEALTH_PORT=9464
# Bearer token for /api/metrics and the worker /metrics endpoint.
METRICS_TOKEN=
# Serverless hosts (Vercel): secret Vercel Cron sends to /api/cron/worker, which runs
# the scheduler + jobs each minute instead of `npm run worker`. Required for that endpoint.
CRON_SECRET=

# Service name stamped on log lines (the worker sets quikreach-worker itself).
QUIKREACH_SERVICE=

# ── Development only ─────────────────────────────────────────────────────────
# Port for `npm run db:local` (embedded PostgreSQL).
LOCAL_PG_PORT=54329
# Allow webhook targets on private/loopback networks (and http://). Refused at startup in production.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
# Password for demo@quikreach.test created by `npm run db:seed:demo` (random if empty).
DEMO_USER_PASSWORD=
LOG_LEVEL=info
