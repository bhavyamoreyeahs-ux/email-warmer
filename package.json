{
  "name": "quikreach",
  "version": "0.1.0",
  "private": true,
  "description": "QuikReach \u2014 email-domain health, mailbox monitoring, deliverability diagnostics and campaign safety (QuikIT ecosystem).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "retention:purge": "tsx --env-file-if-exists=.env scripts/retention-purge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "keys:rotate": "tsx --env-file-if-exists=.env scripts/rotate-keys.ts",
    "bootstrap:owner": "tsx --env-file-if-exists=.env scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tldts": "^7.4.19",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
